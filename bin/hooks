#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  script_path="$(readlink -- "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
workspace_dir="$(cd -P -- "$(dirname -- "$script_path")/.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  printf 'hooks: Node.js 22.12+ is required.\n' >&2
  exit 1
fi
if [[ ! -x "$workspace_dir/node_modules/.bin/tsx" ]]; then
  printf 'hooks: dependencies are missing; run pnpm install in %s\n' "$workspace_dir" >&2
  exit 1
fi

# Keep the caller's directory so relative project/map arguments resolve there.
exec "$workspace_dir/node_modules/.bin/tsx" "$workspace_dir/server/main.ts" --dev "$@"
